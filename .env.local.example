# =============================================================================
# WR Doors × DODA — Local environment variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore — never commit secrets.
# =============================================================================

# Public site URL (used in metadata, hreflang, OG tags, sitemaps)
# Local dev: http://localhost:3000
# Production: https://wrdoors.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----- Neon Postgres -----------------------------------------------------------
# From the Neon dashboard → Connection Details.
#   DATABASE_URL          → the POOLED string (host contains "-pooler"). App runtime.
#   DATABASE_URL_UNPOOLED → the DIRECT string. Used by drizzle-kit + scripts.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# ----- Auth.js (admin login — configured in Phase 2) --------------------------
# AUTH_SECRET: generate with `openssl rand -base64 33`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# The single admin account. ADMIN_PASSWORD_HASH is produced by
# `pnpm tsx scripts/create-admin.ts` (bcrypt). Never store the plain password.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# ----- Image uploads (local filesystem — configured in Phase 3) ---------------
# Defaults are fine for local dev and Hostinger. Override only if needed.
# UPLOADS_DIR="public/uploads"
# NEXT_PUBLIC_UPLOADS_BASE_URL="/uploads"

# ----- Resend (email) --------------------------------------------------------
RESEND_API_KEY=""
# "From" address for transactional emails (must be on a verified Resend domain)
RESEND_FROM_EMAIL="WR Doors <noreply@wrdoors.com>"
# Where admin notifications go
ADMIN_NOTIFICATION_EMAIL="wahatalruman36@gmail.com"

# ----- Optional integrations ------------------------------------------------
# Spline scene URL (used in homepage hero)
NEXT_PUBLIC_SPLINE_SCENE_URL=""
